// Private Worker with the optional extra symbol set (PLAN D5). Reachable only through the
// EXTRA_SET service binding of the main Worker, which checks the session, the per-account
// flag and the file name first: no routes, no workers.dev, no preview URLs.
// The assets (dist/) are built and deployed by the operator outside this repository.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aplikaacja-extra",
  "main": "./src/index.ts",
  "compatibility_date": "2026-11-15",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS" },
}
