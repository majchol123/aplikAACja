// Public ARASAAC mirror (PLAN D4): assets only, no script, so requests are free and unmetered.
// Routes on the app hosts take precedence over the main Worker's Custom Domain, so images and
// the index are same-origin with the app. dist/ is produced by tools/build_arasaac.py and
// tools/build_lexicon.py and deployed by .github/workflows/arasaac-refresh.yml.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aplikaacja-arasaac",
  "compatibility_date": "2026-11-15",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist", "not_found_handling": "none" },
  "routes": [
    { "pattern": "aplikaacja.one.pl/sym/arasaac/*", "zone_name": "aplikaacja.one.pl" },
    {
      "pattern": "staging.aplikaacja.one.pl/sym/arasaac/*",
      "zone_name": "aplikaacja.one.pl",
    },
  ],
}
