// Self-hosted Piper TTS assets Worker (WASM runtime + chunked Polish voice models).
// Assets only, no script, so requests under /tts/* are free and unmetered.
// Built by tools/build_tts.py and deployed per environment in .github/workflows/deploy.yml.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aplikaacja-tts-local",
  "compatibility_date": "2026-11-15",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist", "not_found_handling": "none" },
  "env": {
    "staging": {
      "name": "aplikaacja-tts-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "staging.aplikaacja.one.pl/tts/*", "zone_name": "aplikaacja.one.pl" },
      ],
    },
    "production": {
      "name": "aplikaacja-tts",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "aplikaacja.one.pl/tts/*", "zone_name": "aplikaacja.one.pl" }],
    },
  },
}
