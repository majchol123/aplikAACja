// Main aplikAACja Worker: SPA assets + Hono API + UserVault Durable Object.
// Top level = local development only (never deployed: no routes, workers.dev disabled).
// Deploy: CLOUDFLARE_ENV=<staging|production> vite build && wrangler deploy (.github/workflows/deploy.yml).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "aplikaacja-local",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-11-15",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/sym/extra/*"],
  },
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "USER_VAULT", "class_name": "UserVault" },
      { "name": "CATALOG", "class_name": "Catalog" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserVault"] },
    // Catalogue of public boards (F6, PLAN §2.8): one object for the whole deployment.
    { "tag": "v2", "new_sqlite_classes": ["Catalog"] },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aplikaacja-core-local",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "vars": { "APP_ORIGIN": "http://localhost:5173" },
  // Locally bound only while `pnpm --filter @aplikaacja/extra dev` runs (dev registry);
  // otherwise the gate answers 503.
  "services": [{ "binding": "EXTRA_SET", "service": "aplikaacja-extra" }],

  "env": {
    "staging": {
      "name": "aplikaacja-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "staging.aplikaacja.one.pl", "custom_domain": true }],
      "observability": { "enabled": true },
      "durable_objects": {
        "bindings": [
          { "name": "USER_VAULT", "class_name": "UserVault" },
          { "name": "CATALOG", "class_name": "Catalog" },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aplikaacja-core-staging",
          "database_id": "57448bfe-f19d-467d-bd0f-25bd862d4d29",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "APP_ORIGIN": "https://staging.aplikaacja.one.pl",
        "DO_JURISDICTION": "eu",
      },
      "services": [{ "binding": "EXTRA_SET", "service": "aplikaacja-extra" }],
    },
    "production": {
      "name": "aplikaacja",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "aplikaacja.one.pl", "custom_domain": true }],
      "observability": { "enabled": true },
      "durable_objects": {
        "bindings": [
          { "name": "USER_VAULT", "class_name": "UserVault" },
          { "name": "CATALOG", "class_name": "Catalog" },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aplikaacja-core",
          "database_id": "d6328dbb-0ee3-4f6f-8776-e770b457129c",
          "migrations_dir": "migrations",
        },
      ],
      "vars": { "APP_ORIGIN": "https://aplikaacja.one.pl", "DO_JURISDICTION": "eu" },
      "services": [{ "binding": "EXTRA_SET", "service": "aplikaacja-extra" }],
    },
  },
}
